{
  "uid": "geoflood",
  "title": "Geo Flood Monitor - SLOs",
  "schemaVersion": 39,
  "tags": [
    "geoflood",
    "slo"
  ],
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Newly flooded area (km\u00b2)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "geoflood_flooded_area_km2",
          "legendFormat": "{{aoi}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Hours since last successful run",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "geoflood:hours_since_success",
          "legendFormat": "{{aoi}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Cloud-free coverage",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "geoflood_valid_pixel_ratio",
          "legendFormat": "{{aoi}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tile latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nginx_ingress_controller_request_duration_seconds_bucket{ingress=~\".*titiler\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Tile latency error budget remaining (30d)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (avg_over_time(geoflood:tile_latency_bad:ratio_rate5m[30d]) / 0.01)",
          "legendFormat": "budget"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Tile availability error budget remaining (30d)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (avg_over_time(geoflood:tile_errors:ratio_rate5m[30d]) / 0.005)",
          "legendFormat": "budget"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pipeline run duration",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "geoflood_pipeline_duration_seconds",
          "legendFormat": "{{aoi}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Satellite scene age",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "geoflood_event_scene_age_seconds",
          "legendFormat": "{{aoi}}"
        }
      ]
    }
  ]
}
